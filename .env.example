# Copy to .env.local for development.
# Both are consumed at build time and embedded into the client bundle.
# The Supabase publishable key is safe to ship publicly — RLS policies are
# the real authorization boundary.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Legacy fallback variable names (optional):
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
